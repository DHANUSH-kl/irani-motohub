41/files/250804CC-E797-4841-938D-59CB2F450738.png?v=1787074811\",\"altText\":\"KAWASAKI Ninja 650 (2017-) Galfer Sintered Brake Pads\"}],\"variants\":[{\"id\":\"gid://shopify/ProductVariant/52881689575741\",\"title\":\"front\",\"price\":{\"amount\":\"3299.0\",\"currencyCode\":\"INR\"},\"compareAtPrice\":{\"amount\":\"3299.0\",\"currencyCode\":\"INR\"},\"availableForSale\":true,\"quantityAvailable\":null},{\"id\":\"gid://shopify/ProductVariant/52881689608509\",\"title\":\"rear\",\"price\":{\"amount\":\"3299.0\",\"currencyCode\":\"INR\"},\"compareAtPrice\":{\"amount\":\"3299.0\",\"currencyCode\":\"INR\"},\"availableForSale\":true,\"quantityAvailable\":null}],\"brand\":\"LRL Motors\",\"category\":\"Accessories\",\"compatibility\":[],\"specifications\":[{\"name\":\"Brand\",\"value\":\"LRL Motors\"},{\"name\":\"Category\",\"value\":\"Accessories\"}],\"reviews\":[{\"id\":\"rev-default-1\",\"author\":\"Verified Rider\",\"rating\":5,\"date\":\"2026-06-01\",\"title\":\"Genuine product\",\"comment\":\"Shipped fast, original packing. Performance is exactly as advertised.\"}],\"rating\":4.7,\"hp_gain\":\"$undefined\",\"weight_saved\":\"$undefined\",\"safety_rating\":\"$undefined\",\"tags\":[],\"metafields\":{\"custom\":{\"hp_gain\":\"$undefined\",\"weight_saved\":\"$undefined\",\"safety_rating\":\"$undefined\"}},\"inventoryQuantity\":\"$undefined\",\"inventoryTracked\":\"$undefined\"},{\"id\":\"gid://shopify/Product/10473813541181\",\"handle\":\"ninja-300-abs-galfer-sintered-brake-pads\",\"title\":\"Ninja 300 ABS Galfer Sintered Brake Pads\",\"description\":\"Galfer HH Sintered Brake Pads are a type of brake pads used in high-performance motorcycles, ATVs, and other vehicles. They are made by the Spanish company Galfer, which specializes in braking systems for motorcycles and bicycles. Sintered brake pads are made by fusing metallic particles together under high pressure and heat. The resulting material is very dense and durable, with excellent resistance to heat and wear. This makes sintered brake pads ideal for high-performance applications where consistent braking performance is essential. Galfer HH Sintered Brake Pads are designed for aggressive riding and racing. They offer high levels of stopping power, even at high temperatures, and provide excellent feel and feedback to the rider. They are also resistant to fade and glazing, which can occur when brake pads get too hot and lose their friction properties. Fitment Note: Front : FD117G1370 Rear : FD117G1370 Included Items: 1 Set Comes with 2 HH Sintered Brake Pads Which Fits One Caliper\",\"priceRange\":{\"minVariantPrice\":{\"amount\":\"3499.0\",\"currencyCode\":\"INR\"}},\"images\":[{\"url\":\"https://cdn.shopify.com/s/files/1/1012/0619/6541/files/250804CC-E797-4841-938D-59CB2F450738.png?v=1787074811\",\"altText\":\"Ninja 300 ABS Galfer Sintered Brake Pads\"}],\"variants\":[{\"id\":\"gid://shopify/ProductVariant/52881689248061\",\"title\":\"front\",\"price\":{\"amount\":\"3499.0\",\"currencyCode\":\"INR\"},\"compareAtPrice\":{\"amount\":\"3499.0\",\"currencyCode\":\"INR\"},\"availableForSale\":true,\"quantityAvailable\":null},{\"id\":\"gid://shopify/ProductVariant/52881689280829\",\"title\":\"rear\",\"price\":{\"amount\":\"3499.0\",\"currencyCode\":\"INR\"},\"compareAtPrice\":{\"amount\":\"3499.0\",\"currencyCode\":\"INR\"},\"availableForSale\":true,\"quantityAvailable\":null}],\"brand\":\"Baycity\",\"category\":\"Brake Pads\",\"compatibility\":[\"motorcycle\",\"NINJA 300 ABS\",\"Ninja 300 ABS Galfer Sintered Brake Pads\"],\"specifications\":[{\"name\":\"Brand\",\"value\":\"Baycity\"},{\"name\":\"Category\",\"value\":\"Brake Pads\"}],\"reviews\":[{\"id\":\"rev-default-1\",\"author\":\"Verified Rider\",\"rating\":5,\"date\":\"2026-06-01\",\"title\":\"Genuine product\",\"comment\":\"Shipped fast, original packing. Performance is exactly as advertised.\"}],\"rating\":4.7,\"hp_gain\":\"$undefined\",\"weight_saved\":\"$undefined\",\"safety_rating\":\"$undefined\",\"tags\":[\"motorcycle\"