ned\"}},\"inventoryQuantity\":\"$undefined\",\"inventoryTracked\":\"$undefined\"},{\"id\":\"gid://shopify/Product/10478235975997\",\"handle\":\"akrapovic-ducati-multistrada-1200-enduro-slip-on-line-titanium-2017-18-exhaust\",\"title\":\"Akrapovic DUCATI MULTISTRADA 1200 ENDURO Slip-On Line Titanium 2017-18 Exhaust\",\"description\":\"Product Description Slip-Ons represent the first step in the exhaust system tuning process, and they offer a great balance between price and performance. The Grand Prix–inspired twin conical mufflers are made entirely from titanium, a race-proven material. Beautifully finished with a carbon-fiber heatshield, the exhaust offers an increase in performance and a deeper, more rewarding sound, while meeting EC-ECE type approval. No fuel remapping is required, but for optimal performance use a fuel controller. A combination of beautiful machines and hand welds. Patented hexagonal muffler. Integrated titanium exhaust hanger. CNC machined muffler inlet cap. Optimized to maximize lean angle. All carbon fiber parts are produced in-house. Air-tight quality controlled production means your exhaust will be perfect.\",\"priceRange\":{\"minVariantPrice\":{\"amount\":\"87000.0\",\"currencyCode\":\"INR\"}},\"images\":[{\"url\":\"https://cdn.shopify.com/s/files/1/1012/0619/6541/files/Akrapovic-DUCATI-MULTISTRADA-1200-ENDURO-Slip-On-Line-Titanium-2017-18-Exhaust-Riders-Junction.png?v=1787335741\",\"altText\":\"Akrapovic DUCATI MULTISTRADA 1200 ENDURO Slip-On Line Titanium 2017-18 Exhaust\"}],\"variants\":[{\"id\":\"gid://shopify/ProductVariant/52911733702973\",\"title\":\"Default Title\",\"price\":{\"amount\":\"87000.0\",\"currencyCode\":\"INR\"},\"compareAtPrice\":null,\"availableForSale\":true,\"quantityAvailable\":null}],\"brand\":\"Akrapovic\",\"category\":\"Accessories\",\"compatibility\":[\"Akrapovic Accessories\"],\"specifications\":[{\"name\":\"Brand\",\"value\":\"Akrapovic\"},{\"name\":\"Category\",\"value\":\"Accessories\"}],\"reviews\":[{\"id\":\"rev-default-1\",\"author\":\"Verified Rider\",\"rating\":5,\"date\":\"2026-06-01\",\"title\":\"Genuine product\",\"comment\":\"Shipped fast, original packing. Performance is exactly as advertised.\"}],\"rating\":4.7,\"hp_gain\":\"$undefined\",\"weight_saved\":\"$undefined\",\"safety_rating\":\"$undefined\",\"tags\":[\"Akrapovic Accessories\"],\"metafields\":{\"custom\":{\"hp_gain\":\"$undefined\",\"weight_saved\":\"$undefined\",\"safety_rating\":\"$undefined\"}},\"inventoryQuantity\":\"$undefined\",\"inventoryTracked\":\"$undefined\"},{\"id\":\"gid://shopify/Product/10478235910461\",\"handle\":\"akrapovic-honda-africa-twin-adventure-sports-racing-line-titanium-2020-exhaust\",\"title\":\"Akrapovic HONDA Africa Twin Adventure Sports Racing Line Titanium 2020+ Exhaust\",\"description\":\"Product Description The Akrapovič Racing system is designed for riders who demand maximum performance. The racing system is lighter if compared to the stock exhaust system and features exceptional production quality, hi-tech materials, and of course, increased engine performance combined with pure racing sound output. The double-flow muffler is a unique combination of a hexagonal shape and a more classic rear endcap, finished with a durable titanium muffler sleeve and robust carbon-fiber clamp. No fuel remapping is required, but for optimal performance use a fuel controller. A combination of beautiful machines and hand welds. Patented hexagonal muffler. Integrated titanium exhaust hanger. CNC machined muffler inlet cap. Optimized to maximize lean angle. All carbon fiber parts are produced in-house. Air-tight quality controlled production means your exhaust will be perfect.\",\"priceRange\":{\"minVariantPrice\":{\"amount\":\"128000.0\",\"currencyCode\":\"INR\"}},\"images\":[{\"url\":\"https://cdn.shopify.com/s/files/1/1012/0619/6541/files/Akrapovic-HONDA-Africa-Twin-Adventure-Sports-Racing-Line-Titanium-2020-Exhaust-Riders-Junction.png?v=1787335740\",\"altText\":\"Akrapovic HONDA Africa Twin Adventure Sports Racing Line Titanium 2020+ Exhaust\"}],\"variants\":[{\"id\":\"gid://shopify/ProductVariant/52911733670205\",\"title\":\"Default Title\",\"price\":{\"amount\":\"128000.0\",\"currencyCode\":\"INR\"},\"compareAtPrice\":null,\"availableForSale\":true,\"quantityAvailable\":null}],\"brand\":\"Akrapovic\",\"category\":\"Accessories\",\"compatibility\":[\"Akrapovic Accessories\"],\"specifications\":[{\"name\":\"Brand\",\"value\":\"Akrapovic\"},{\"name\":\"Category\",\"value\":\"Accessories\"}],\"reviews\":[{\"id\":\"rev-default-1\",\"author\":\"Verified Rider\",\"rating\":5,\"date\":\"2026-06-01\",\"title\":\"Genuine product\",\"comment\":\"Shipped fast, original packing. Performance is exactly as advertised.\"}],\"rating\":4.7,\"hp_gain\":\"$undefined\",\"weight_saved\":\"$undefined\",\"safety_rating\":\"$undefined\",\"tags\":[\"Akrapovic Accessories\"],\"metafields\":{\"custom\":{\"hp_gain\":\"$undefined\",\"weight_saved\":\"$undefined\",\"safety_rating\":\"$undefined\"}},\"inventoryQuantity\":\"$undefined\",\"inventoryTracked\":\"$undefined\"},{\"id\":\"gid://shopify/Product/10478235877693\",\"handle\":\"akrapovic-honda-cb-300-r-slip-on-line-carbon-2018-exhaust\",\"title\":\"Akrapovic HONDA CB 300 R Slip-On Line Carbon 2018+ Exhaust\",\"description\":\"Product Description Slip-Ons represent the first step in the exhaust system tuning process, and they offer a great balance between price and performance. Change the nature of your bike by adding more power, improved performance, and the unique Akrapovič sound. Everything is packed in stylishly designed Slip-On exhaust systems. The result of taking design very seriously is a beautifully crafted exhaust system with a carbon fiber muffler outer sleeve and end cap. Race-proven materials. No fuel remapping is required, but for optimal performance use a fuel controller. A combination of beautiful machines and hand welds. Patented hexagonal muffler. Integrated titanium exhaust hanger. CNC machined muffl