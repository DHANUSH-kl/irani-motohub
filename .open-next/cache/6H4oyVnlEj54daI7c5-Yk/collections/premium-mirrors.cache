tle\":\"Hi Fast Folding Anti glare Mirrors\",\"description\":\"Engineered with genuine accents and precision-machined aluminum alloy, the Folding Mirror delivers superior rear visibility—up to 50% wider field of view than standard mirrors. The anti-glare coating minimizes headlight reflection for safer night riding, while the quick-folding mechanism protects against impact damage during reverse maneuvers. A universal ball joint enables full 360-degree adjustment, letting you optimize your sightline for any riding position.\",\"priceRange\":{\"minVariantPrice\":{\"amount\":\"2495.0\",\"currencyCode\":\"INR\"}},\"images\":[{\"url\":\"https://cdn.shopify.com/s/files/1/1012/0619/6541/files/31tST5NIkwL.jpg?v=1787658573\",\"altText\":\"Hi Fast Folding Anti glare Mirrors\"},{\"url\":\"https://cdn.shopify.com/s/files/1/1012/0619/6541/files/61NsiTLSnfL._SL1321.jpg?v=1787658556\",\"altText\":\"Hi Fast Folding Anti glare Mirrors\"},{\"url\":\"https://cdn.shopify.com/s/files/1/1012/0619/6541/files/51P8b11CMjL.jpg?v=1787658561\",\"altText\":\"Hi Fast Folding Anti glare Mirrors\"},{\"url\":\"https://cdn.shopify.com/s/files/1/1012/0619/6541/files/391E1A79-5D88-485E-800A-C350A860941F.png?v=1787075859\",\"altText\":\"Hi Fast Folding Anti glare Mirrors\"}],\"variants\":[{\"id\":\"gid://shopify/ProductVariant/52880902422845\",\"title\":\"Default Title\",\"price\":{\"amount\":\"2495.0\",\"currencyCode\":\"INR\"},\"compareAtPrice\":{\"amount\":\"3000.0\",\"currencyCode\":\"INR\"},\"availableForSale\":true,\"quantityAvailable\":null}],\"brand\":\"Primo Customs\",\"category\":\"Accessories\",\"compatibility\":[],\"specifications\":[{\"name\":\"Brand\",\"value\":\"Primo Customs\"},{\"name\":\"Category\",\"value\":\"Accessories\"}],\"reviews\":[{\"id\":\"rev-default-1\",\"author\":\"Verified Rider\",\"rating\":5,\"date\":\"2026-06-01\",\"title\":\"Genuine product\",\"comment\":\"Shipped fast, original packing. Performance is exactly as advertised.\"}],\"rating\":4.7,\"hp_gain\":\"$undefined