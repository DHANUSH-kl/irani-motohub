ory\",\"value\":\"Accessories\"}],\"reviews\":[{\"id\":\"rev-default-1\",\"author\":\"Verified Rider\",\"rating\":5,\"date\":\"2026-06-01\",\"title\":\"Genuine product\",\"comment\":\"Shipped fast, original packing. Performance is exactly as advertised.\"}],\"rating\":4.7,\"tags\":[],\"metafields\":{\"custom\":{}}},{\"id\":\"gid://shopify/Product/10473566535997\",\"handle\":\"simtac-spider-grip-with-vibration-damper-mh02-pro\",\"title\":\"Simtac spider grip with vibration damper (MH02-PRO)\",\"description\":\"Simtac Spider Grip MH02-PRO is a rugged motorcycle mobile holder crafted for riders who prioritize firm grip, reliable performance, and ride-ready features. With a distinctive six-arm clamping system, universal compatibility, anti-theft design, 360° rotation, and a built-in vibration damper, it keeps your phone stable and safe—even on rough terrains. Ideal for navigation, calls, and music—your phone stays secure, wherever your journey leads. Note: Always select appropriate handle mount spacer 22 MM/ 25 MM according to your bike handle diameter to avoid damages Do not place handle mount on curvy areas of handle bar. ⇒ Package Contents : Mobile Holder (1 nos.) Handle Mount (1 nos.) Allen Key (1 nos.) Thank you Card (1 nos.) Warranty Card (1 nos.)\",\"priceRange\":{\"minVariantPrice\":{\"amount\":\"1249.0\",\"currencyCode\":\"INR\"}},\"images\":[{\"url\":\"https://cdn.shopify.com/s/files/1/1012/0619/6541/files/12345.jpg?v=1787060352\",\"altText\":\"Simtac spider grip with vibration damper (MH02-PRO)\"},{\"url\":\"https://cdn.shopify.com/s/files/1/1012/0619/6541/files/MH02PRO-2.jpg?v=1787060352\",\"altText\":\"Simtac spider grip with vibration damper (MH02-PRO)\"},{\"url\":\"https://cdn.shopify.com/s/files/1/1012/0619/6541/files/MH02PRO-3.jpg?v=1787060353\",\"altText\":\"Simtac spider grip with vibration damper (MH02-PRO)\"},{\"url\":\"https://cdn.shopify.com/s/files/1/1012/0619/6541/files/MH02PRO-9-1024x1024.jpg?v=1787060352\",\"altText\":\"Simtac spider grip with vibration damper (MH02-PRO)\"},{\"url\":\"https://cdn.shopify.com/s/files/1/1012/0619/6541/files/MH02PRO-6-1024x1024.jpg?v=1787060352\",\"altText\":\"Simtac spider grip with vibration damper (MH02-PRO)\"}],\"variants\":[{\"id\":\"gid://shopify/ProductVariant/52881017930045\",\"title\":\"Default Title\",\"price\":{\"amount\":\"1249.0\",\"currencyCode\":\"INR\"},\"compareAtPrice\":{\"amount\":\"2599.0\",\"currencyCode\":\"INR\"},\"availableForSale\":true,\"quantityAvailable\":null}],\"brand\":\"Primo Customs\",\"category\":\"Accessories\",\"compatibility\":[],\"specifications\":[{\"name\":\"Brand\",\"value\":\"Primo Customs\"},{\"name\":\"Category\",\"value\":\"Accessories\"}],\"reviews\":[{\"id\":\"rev-default-1\",\"author\":\"Verified Rider\",\"rating\":5,\"date\":\"2026-06-01\",\"title\":\"Genuine product\",\"comment\":\"Shipped fast, original packing. Performance is exactly as advertised.\"}],\"rating\":4.7,\"tags\":[],\"metafields\":{\"custom\":{}}},{\"id\":\"gid://shopify/Product/10473566503229\",\"handle\":\"simtac-splash-guard-x-with-vibration-damper-and-wireless-charger-mhwpwc-pro\",\"title\":\"Simtac splash guard X with vibration damper and wireless charger (MHWPWC-PRO)\",\"description\":\"Simtac Splash Guard X MHWPWC-PRO is a high-performance waterproof mobile holder featuring built-in wireless charging, USB-C connectivity, and an advanced vibration damper. Built for adventurers and daily commuters alike, it offers full phone protection, firm grip, and seamless charging—delivering convenience and reliability on every ride. Note: Always select appropriate handle mount spacer 22 MM/ 25 MM according to your bike handle diameter to avoid damages Do not place handle mount on curvy areas of handle bar. ⇒ Package Contents : Mobile Holder (1 nos.) Handle Mount (1 nos.) Allen Key (1 nos.) Thank you Card (1 nos.) Warranty Card (1 nos.)\",\"priceRange\":{\"minVariantPrice\":{\"amount\":\"3849.0\",\"currencyCode\":\"INR\"}},\"images\":[{\"url\":\"https://cdn.shopify.c