      "page": "/collections/[handle]",
      "regex": "^/collections/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPhandle": "nxtPhandle"
      },
      "namedRegex": "^/collections/(?<nxtPhandle>[^/]+?)(?:/)?$"
    },
    {
